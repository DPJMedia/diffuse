# Copy to .env.local for local development.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production only on Vercel — do NOT set your live site URL here for day-to-day local dev
# (it breaks email/OAuth redirects). In development, non-localhost values are ignored unless you set:
# NEXT_PUBLIC_USE_SITE_URL_IN_DEV=true
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# When `next dev` prints a different port (3001, 3002…) because 3000 is busy, set it so any
# server-side URL helpers match: NEXT_PUBLIC_DEV_PORT=3003

# Pull-from-URL — YouTube, Vimeo, and other video platforms:
# Self-host Cobalt (https://github.com/imputnet/cobalt) and set your instance URL.
# Free option: deploy the Cobalt Docker image on Railway (https://railway.app), e.g.
#   ghcr.io/imputnet/cobalt:latest
# Set Railway env API_URL to your public URL and COBALT_CORS_WILDCARD=1 if you need CORS.
# COBALT_API_URL=https://your-cobalt.railway.app
# COBALT_API_KEY=your-key   # only if your Cobalt instance requires API key auth
#
# Swagit / direct CDN links do not need Cobalt — only YouTube-style URLs use COBALT_API_URL.

# Async workflow callback secret (optional but recommended).
# Set this to a random string and send it as "Authorization: Bearer <value>" from the
# n8n HTTP Request node that POSTs to /api/workflow/callback. If unset, the callback
# endpoint accepts requests without a secret (suitable for development only).
# WORKFLOW_CALLBACK_SECRET=
